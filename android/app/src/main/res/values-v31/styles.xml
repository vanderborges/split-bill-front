<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: a splash do sistema usa windowSplashScreenBackground (e
         o ícone do app) em vez do launch_background. Mesmo creme da
         abertura animada (SplashLoading) pra a troca não piscar. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FDF4E8</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
